<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <div class="col-8 offset-2">
        <h2>Edit Your listings</h2>
        <form method="post" 
            action="/listings/<%= listing.id %>?_method=PUT" novalidate 
            class="needs-validation"
        >
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input required name="listing[title]" value="<%= listing.title %> " type="text" class="form-control">
                
                <div class="invalid-feedback">Please enter a valid title</div>
            </div>
            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea  name="listing[description]" class="form-control required"><%= listing.description %></textarea>
                <div class="invalid-feedback">Please enter a short description</div>
            </div>
            <div class="mb-3">
                <label for="image" class="form-label">Image Link</label>
                <input required name="listing[image][url]" value="<%= listing.image.url %>" type="text" class="form-control">
                
            </div>
            <div class="row">
                <div class="mb-3 col-md-4">
                    <label for="price" class="form-label">Price</label>
                    <input required name="listing[price]" value="<%= listing.price %>" type="text" class="form-control">
                    <div class="invalid-feedback">Please enter a valid Price</div>
                </div>
                <div class="mb-3 col-md-8">
                    <label for="country" class="form-label">country</label>
                    <input required name="listing[country]" value="<%= listing.country %>" type="text" class="form-control">
                    <div class="invalid-feedback">Please enter a valid Country</div>
                </div>
            </div>
            <div class="mb-3">
                <label for="location" class="form-label">location</label>
                <input required name="listing[location]" value="<%= listing.location %>" type="text" class="form-control">
                <div class="invalid-feedback">Please enter a valid location</div>
            </div>
            <button class="btn btn-dark edit-btn mt-3">Edit</button>
        </form>
    </div>
</div>
